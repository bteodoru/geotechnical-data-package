{
  "$comment": "GDP (Geotechnical Data Package) v0.1 - machine-readable schema. Single source for the validator, table documentation and database schema. Language-neutral: human-language labels live in optional locale files.",
  "format": "gdp",
  "version": "0.1",
  "localization": {
    "path": "locales/gdp-{version}.{lang}.json",
    "optional": true,
    "note": "Locale files map schema paths (e.g. 'tables.lab_index.fields.w') to a label, description and synonyms. They are distributed with the schema, never inside packages."
  },
  "constants": {
    "g": {
      "value": 9.81,
      "unit": "m/s2",
      "use": "rho <-> gamma conversion"
    }
  },
  "types": {
    "id": {
      "base": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,24}$"
    },
    "text": {
      "base": "string"
    },
    "number": {
      "base": "number"
    },
    "integer": {
      "base": "integer"
    },
    "date": {
      "base": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "datetime": {
      "base": "string",
      "format": "ISO 8601 with UTC offset"
    },
    "bool": {
      "base": "boolean",
      "values": [
        "true",
        "false"
      ]
    },
    "code": {
      "base": "string",
      "note": "value from a vocabulary (field 'vocabulary')"
    },
    "file_ref": {
      "base": "string",
      "pattern": "^[^#]+(#page=[1-9][0-9]*)?$",
      "note": "Path relative to attachments/, optionally followed by #page=N (1-based PDF page)."
    }
  },
  "unit_system": {
    "name": "UCUM",
    "variant": "case-sensitive",
    "reference": "https://ucum.org/ucum",
    "note": "Units are fixed per field; only their spelling follows UCUM (c/s). Header: name[unit]."
  },
  "csv": {
    "encoding": "utf-8",
    "bom_allowed": true,
    "dialects": [
      {
        "delimiter": ",",
        "decimal": "."
      },
      {
        "delimiter": ";",
        "decimal": ","
      }
    ],
    "dialect_detection": "Per file, from the header row: the dialect whose delimiter is the only one present in it; otherwise the first. Column names never contain ',' or ';'. Writers should use the first dialect.",
    "quoting": "RFC 4180",
    "missing_value": "",
    "header": "name[unit]; dimensionless quantities without brackets"
  },
  "vocabularies": {
    "point_type": [
      "borehole",
      "cpt",
      "dp",
      "trial_pit",
      "well"
    ],
    "water_kind": [
      "struck",
      "stable",
      "reading"
    ],
    "sample_kind": [
      "undisturbed",
      "disturbed",
      "core",
      "water"
    ],
    "filter_position": [
      "u1",
      "u2",
      "u3"
    ],
    "soil_symbol": {
      "open": true,
      "note": "SR EN ISO 14688-2 symbols. Closed list is an open decision."
    },
    "tests": {
      "water_content": {
        "quantities": [
          "w"
        ],
        "reference_standard": "SR EN ISO 17892-1",
        "methods": []
      },
      "bulk_density": {
        "quantities": [
          "rho",
          "gamma"
        ],
        "reference_standard": "SR EN ISO 17892-2",
        "methods": [
          "linear_measurement",
          "immersion",
          "fluid_displacement"
        ]
      },
      "particle_density": {
        "quantities": [
          "rho_s",
          "gamma_s"
        ],
        "reference_standard": "SR EN ISO 17892-3",
        "methods": [
          "fluid_pycnometer",
          "gas_pycnometer"
        ]
      },
      "grain_size": {
        "quantities": [
          "clay",
          "silt",
          "sand",
          "gravel"
        ],
        "reference_standard": "SR EN ISO 17892-4",
        "methods": [
          "sieving",
          "sieving_hydrometer",
          "sieving_pipette",
          "hydrometer",
          "pipette",
          "laser_diffraction"
        ]
      },
      "atterberg": {
        "quantities": [
          "wL",
          "wP"
        ],
        "reference_standard": "SR EN ISO 17892-12",
        "methods": [
          "fall_cone",
          "casagrande"
        ],
        "method_applies_to": "wL"
      },
      "cpt": {
        "quantities": [
          "cpt_data"
        ],
        "reference_standard": "SR EN ISO 22476-1",
        "methods": []
      }
    },
    "reserved_tests": [
      "oedometer",
      "unconfined_compression",
      "triaxial_uu",
      "triaxial_cu",
      "triaxial_cd",
      "direct_shear_uu",
      "direct_shear_cu",
      "direct_shear_cd",
      "permeability",
      "compaction",
      "organic_content",
      "carbonate_content",
      "swelling",
      "collapse"
    ],
    "fractions_registry": {
      "$comment": "Registry: standard -> upper size limits of fractions [mm]. Grows with the standards registry.",
      "SR EN ISO 14688-1": {
        "clay": 0.002,
        "silt": 0.063,
        "sand": 2.0,
        "gravel": 63.0
      }
    },
    "standards_registry": [
      "SR EN ISO 14688-1",
      "SR EN ISO 14688-2",
      "SR EN ISO 17892-1",
      "SR EN ISO 17892-2",
      "SR EN ISO 17892-3",
      "SR EN ISO 17892-4",
      "SR EN ISO 17892-12",
      "SR EN ISO 22476-1"
    ]
  },
  "documents": {
    "manifest": {
      "path": "manifest.toml",
      "required": true,
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "required": [
          "format",
          "version",
          "project"
        ],
        "additionalProperties": false,
        "properties": {
          "format": {
            "const": "gdp"
          },
          "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+$"
          },
          "project": {
            "type": "object",
            "required": [
              "uuid",
              "id",
              "name",
              "crs"
            ],
            "additionalProperties": false,
            "properties": {
              "uuid": {
                "type": "string",
                "format": "uuid"
              },
              "id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "location": {
                "type": "string"
              },
              "client": {
                "type": "string"
              },
              "crs": {
                "type": "string",
                "pattern": "^EPSG:\\d+$"
              },
              "vertical_datum": {
                "type": "string"
              }
            }
          },
          "producer": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "organisation": {
                "type": "string"
              },
              "author": {
                "type": "string"
              },
              "date": {
                "type": "string",
                "format": "date"
              },
              "software": {
                "type": "string"
              }
            }
          },
          "profiles": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "cpt": {
                "type": "string"
              },
              "lab_index": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "campaign": {
      "path": "campaigns/{campaign}.toml",
      "key_from_path": "campaign",
      "min_count": 1,
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "description": {
            "type": "string"
          },
          "organisation": {
            "type": "string"
          },
          "year": {
            "type": "integer",
            "minimum": 1900,
            "maximum": 2100
          },
          "standards": {
            "type": "object",
            "propertyNames": {
              "anyOf": [
                {
                  "enum": [
                    "water_content",
                    "bulk_density",
                    "particle_density",
                    "grain_size",
                    "atterberg",
                    "cpt",
                    "oedometer",
                    "unconfined_compression",
                    "triaxial_uu",
                    "triaxial_cu",
                    "triaxial_cd",
                    "direct_shear_uu",
                    "direct_shear_cu",
                    "direct_shear_cd",
                    "permeability",
                    "compaction",
                    "organic_content",
                    "carbonate_content",
                    "swelling",
                    "collapse"
                  ]
                },
                {
                  "pattern": "^x_"
                }
              ]
            },
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "methods": {
            "type": "object",
            "properties": {
              "bulk_density": {
                "enum": [
                  "linear_measurement",
                  "immersion",
                  "fluid_displacement"
                ]
              },
              "particle_density": {
                "enum": [
                  "fluid_pycnometer",
                  "gas_pycnometer"
                ]
              },
              "grain_size": {
                "enum": [
                  "sieving",
                  "sieving_hydrometer",
                  "sieving_pipette",
                  "hydrometer",
                  "pipette",
                  "laser_diffraction"
                ]
              },
              "atterberg": {
                "enum": [
                  "fall_cone",
                  "casagrande"
                ]
              }
            },
            "patternProperties": {
              "^x_": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "fractions": {
            "type": "object",
            "required": [
              "source"
            ],
            "additionalProperties": false,
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1
              },
              "upper_mm": {
                "type": "object",
                "required": [
                  "clay",
                  "silt",
                  "sand",
                  "gravel"
                ],
                "additionalProperties": false,
                "properties": {
                  "clay": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "silt": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "sand": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "gravel": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                }
              }
            },
            "if": {
              "properties": {
                "source": {
                  "const": "custom"
                }
              }
            },
            "then": {
              "required": [
                "source",
                "upper_mm"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "upper_mm"
                ]
              }
            }
          }
        }
      }
    }
  },
  "tables": {
    "points": {
      "path": "points.csv",
      "required": true,
      "min_rows": 1,
      "primary_key": [
        "point_id"
      ],
      "fields": [
        {
          "name": "point_id",
          "type": "id",
          "required": true,
          "description": "Unique within the project."
        },
        {
          "name": "type",
          "type": "code",
          "required": true,
          "vocabulary": "point_type"
        },
        {
          "name": "campaign",
          "type": "id",
          "required": false,
          "references": "campaign",
          "description": "Required when the package has more than one campaign."
        },
        {
          "name": "easting",
          "type": "number",
          "unit": "m",
          "required": true
        },
        {
          "name": "northing",
          "type": "number",
          "unit": "m",
          "required": true
        },
        {
          "name": "elevation",
          "type": "number",
          "unit": "m",
          "required": false,
          "recommended": true
        },
        {
          "name": "final_depth",
          "type": "number",
          "unit": "m",
          "required": true,
          "minimum": 0
        },
        {
          "name": "station",
          "type": "number",
          "unit": "m",
          "required": false,
          "required_if": {
            "field": "offset"
          },
          "description": "Chainage along the alignment, in metres (km 12+345.60 -> 12345.60)."
        },
        {
          "name": "offset",
          "type": "number",
          "unit": "m",
          "required": false,
          "description": "Distance from the alignment: positive to the right, looking towards increasing station."
        },
        {
          "name": "alignment",
          "type": "text",
          "required": false,
          "description": "Name of the alignment the station refers to."
        },
        {
          "name": "date_start",
          "type": "date",
          "required": false
        },
        {
          "name": "date_end",
          "type": "date",
          "required": false
        },
        {
          "name": "method",
          "type": "text",
          "required": false
        },
        {
          "name": "source_file",
          "type": "file_ref",
          "required": false,
          "references": "attachment",
          "description": "Source document in attachments/, optionally with #page=N."
        },
        {
          "name": "remarks",
          "type": "text",
          "required": false
        }
      ]
    },
    "units": {
      "path": "units.csv",
      "required": false,
      "primary_key": [
        "unit_id"
      ],
      "fields": [
        {
          "name": "unit_id",
          "type": "id",
          "required": true
        },
        {
          "name": "name",
          "type": "text",
          "required": true
        },
        {
          "name": "description",
          "type": "text",
          "required": false
        },
        {
          "name": "remarks",
          "type": "text",
          "required": false
        }
      ]
    },
    "layers": {
      "path": "layers.csv",
      "required": false,
      "primary_key": [
        "point_id",
        "depth_top"
      ],
      "foreign_keys": [
        {
          "fields": [
            "point_id"
          ],
          "reference": {
            "table": "points",
            "fields": [
              "point_id"
            ]
          }
        },
        {
          "fields": [
            "unit"
          ],
          "reference": {
            "table": "units",
            "fields": [
              "unit_id"
            ]
          }
        }
      ],
      "interval": [
        "depth_top",
        "depth_base"
      ],
      "fields": [
        {
          "name": "point_id",
          "type": "id",
          "required": true
        },
        {
          "name": "depth_top",
          "type": "number",
          "unit": "m",
          "required": true,
          "minimum": 0
        },
        {
          "name": "depth_base",
          "type": "number",
          "unit": "m",
          "required": true
        },
        {
          "name": "description",
          "type": "text",
          "required": true
        },
        {
          "name": "soil_symbol",
          "type": "code",
          "required": false,
          "vocabulary": "soil_symbol"
        },
        {
          "name": "unit",
          "type": "id",
          "required": false
        },
        {
          "name": "source_file",
          "type": "file_ref",
          "required": false,
          "references": "attachment",
          "description": "Source document in attachments/, optionally with #page=N."
        }
      ]
    },
    "water": {
      "path": "water.csv",
      "required": false,
      "primary_key": null,
      "foreign_keys": [
        {
          "fields": [
            "point_id"
          ],
          "reference": {
            "table": "points",
            "fields": [
              "point_id"
            ]
          }
        }
      ],
      "fields": [
        {
          "name": "point_id",
          "type": "id",
          "required": true
        },
        {
          "name": "kind",
          "type": "code",
          "required": true,
          "vocabulary": "water_kind"
        },
        {
          "name": "depth",
          "type": "number",
          "unit": "m",
          "required": true
        },
        {
          "name": "datetime",
          "type": "datetime",
          "required": false
        },
        {
          "name": "source_file",
          "type": "file_ref",
          "required": false,
          "references": "attachment",
          "description": "Source document in attachments/, optionally with #page=N."
        },
        {
          "name": "remarks",
          "type": "text",
          "required": false
        }
      ]
    },
    "samples": {
      "path": "samples.csv",
      "required": false,
      "primary_key": [
        "sample_id"
      ],
      "foreign_keys": [
        {
          "fields": [
            "point_id"
          ],
          "reference": {
            "table": "points",
            "fields": [
              "point_id"
            ]
          }
        }
      ],
      "interval": [
        "depth_top",
        "depth_base"
      ],
      "fields": [
        {
          "name": "sample_id",
          "type": "id",
          "required": true
        },
        {
          "name": "point_id",
          "type": "id",
          "required": true
        },
        {
          "name": "campaign",
          "type": "id",
          "required": false,
          "references": "campaign"
        },
        {
          "name": "depth_top",
          "type": "number",
          "unit": "m",
          "required": true,
          "minimum": 0
        },
        {
          "name": "depth_base",
          "type": "number",
          "unit": "m",
          "required": false
        },
        {
          "name": "kind",
          "type": "code",
          "required": true,
          "vocabulary": "sample_kind"
        },
        {
          "name": "source_file",
          "type": "file_ref",
          "required": false,
          "references": "attachment",
          "description": "Source document in attachments/, optionally with #page=N."
        },
        {
          "name": "remarks",
          "type": "text",
          "required": false
        }
      ]
    },
    "lab_index": {
      "path": "lab/index.csv",
      "profile": "lab_index",
      "required": false,
      "primary_key": [
        "sample_id"
      ],
      "foreign_keys": [
        {
          "fields": [
            "sample_id"
          ],
          "reference": {
            "table": "samples",
            "fields": [
              "sample_id"
            ]
          }
        }
      ],
      "exclusive_groups": [
        {
          "rule": "E12",
          "options": [
            [
              "rho",
              "rho_s"
            ],
            [
              "gamma",
              "gamma_s"
            ]
          ]
        }
      ],
      "fields": [
        {
          "name": "sample_id",
          "type": "id",
          "required": true
        },
        {
          "name": "w",
          "type": "number",
          "unit": "%",
          "test": "water_content"
        },
        {
          "name": "wL",
          "type": "number",
          "unit": "%",
          "test": "atterberg"
        },
        {
          "name": "wP",
          "type": "number",
          "unit": "%",
          "test": "atterberg"
        },
        {
          "name": "rho",
          "type": "number",
          "unit": "Mg/m3",
          "test": "bulk_density"
        },
        {
          "name": "rho_s",
          "type": "number",
          "unit": "Mg/m3",
          "test": "particle_density"
        },
        {
          "name": "gamma",
          "type": "number",
          "unit": "kN/m3",
          "test": "bulk_density"
        },
        {
          "name": "gamma_s",
          "type": "number",
          "unit": "kN/m3",
          "test": "particle_density"
        },
        {
          "name": "clay",
          "type": "number",
          "unit": "%",
          "test": "grain_size"
        },
        {
          "name": "silt",
          "type": "number",
          "unit": "%",
          "test": "grain_size"
        },
        {
          "name": "sand",
          "type": "number",
          "unit": "%",
          "test": "grain_size"
        },
        {
          "name": "gravel",
          "type": "number",
          "unit": "%",
          "test": "grain_size"
        },
        {
          "name": "source_file",
          "type": "file_ref",
          "required": false,
          "references": "attachment",
          "description": "Source document in attachments/, optionally with #page=N."
        },
        {
          "name": "remarks",
          "type": "text"
        }
      ]
    },
    "cpt_tests": {
      "path": "cpt/tests.csv",
      "profile": "cpt",
      "required": false,
      "primary_key": [
        "test_id"
      ],
      "foreign_keys": [
        {
          "fields": [
            "point_id"
          ],
          "reference": {
            "table": "points",
            "fields": [
              "point_id"
            ]
          }
        }
      ],
      "fields": [
        {
          "name": "test_id",
          "type": "id",
          "required": true
        },
        {
          "name": "point_id",
          "type": "id",
          "required": true
        },
        {
          "name": "date",
          "type": "date",
          "required": true
        },
        {
          "name": "cone_area",
          "type": "number",
          "unit": "cm2",
          "required": true
        },
        {
          "name": "area_ratio",
          "type": "number",
          "required_if": {
            "data_column": "u"
          },
          "minimum": 0,
          "maximum": 1
        },
        {
          "name": "filter_position",
          "type": "code",
          "required_if": {
            "data_column": "u"
          },
          "vocabulary": "filter_position"
        },
        {
          "name": "predrill_depth",
          "type": "number",
          "unit": "m"
        },
        {
          "name": "equipment",
          "type": "text"
        },
        {
          "name": "source_file",
          "type": "file_ref",
          "required": false,
          "references": "attachment",
          "description": "Source document in attachments/, optionally with #page=N."
        },
        {
          "name": "remarks",
          "type": "text"
        }
      ]
    },
    "cpt_data": {
      "path": "cpt/data/{test_id}.csv",
      "profile": "cpt",
      "key_from_path": "test_id",
      "parent": "cpt_tests",
      "primary_key": [
        "depth"
      ],
      "strictly_increasing": "depth",
      "fields": [
        {
          "name": "depth",
          "type": "number",
          "unit": "m",
          "required": true
        },
        {
          "name": "qc",
          "type": "number",
          "unit": "MPa",
          "required": true
        },
        {
          "name": "fs",
          "type": "number",
          "unit": "kPa",
          "required": true
        },
        {
          "name": "u",
          "type": "number",
          "unit": "kPa"
        },
        {
          "name": "inclination",
          "type": "number",
          "unit": "deg"
        }
      ]
    }
  },
  "derivations": {
    "sample_reference_depth": "depth_base empty ? depth_top : (depth_top + depth_base) / 2",
    "sample_campaign": "samples.campaign ?? points.campaign ?? (the package's only campaign)",
    "sample_unit": "layer of the point with depth_top <= reference_depth < depth_base (the last layer includes its base when base = final_depth) -> layers.unit",
    "cpt_unit": "layer of the test's point with depth_top <= depth < depth_base (the last layer includes its base when base = final_depth) -> layers.unit"
  },
  "rules": [
    {
      "code": "E01",
      "level": "error",
      "text": "manifest.toml and the campaign files are valid TOML and match their schemas (format, version, project.uuid, project.id, project.name, project.crs).",
      "checks": {
        "manifest_missing": {
          "message": "manifest.toml not found",
          "missing": true
        },
        "toml_syntax": {
          "message": "TOML syntax error: {detail}"
        },
        "schema_violation": {
          "message": "{key}: {detail}"
        },
        "required_key": {
          "message": "required key {key} is missing",
          "missing": true
        },
        "version_unsupported": {
          "message": "version {version} is not supported (expected {expected})"
        }
      }
    },
    {
      "code": "E02",
      "level": "error",
      "text": "points has at least one row; campaigns/ has at least one file.",
      "checks": {
        "no_points": {
          "message": "points.csv is missing or has no rows",
          "missing": true
        },
        "no_campaigns": {
          "message": "campaigns/ has no campaign file",
          "missing": true
        }
      }
    },
    {
      "code": "E03",
      "level": "error",
      "text": "Required columns are present, with exact name and unit.",
      "checks": {
        "missing_column": {
          "message": "required column {column} is missing",
          "missing": true
        },
        "wrong_unit": {
          "message": "{name} has unit [{found}], expected [{expected}]"
        },
        "duplicate_column": {
          "message": "column {name} appears more than once"
        },
        "bad_header": {
          "message": "header cell {cell} is not name or name[unit]"
        },
        "unreadable": {
          "message": "file cannot be read as CSV: {detail}"
        },
        "not_utf8": {
          "message": "file is not UTF-8: save it as CSV UTF-8"
        },
        "separator_unknown": {
          "message": "the header is a single cell: columns must be separated by , or ;"
        }
      }
    },
    {
      "code": "E04",
      "level": "error",
      "text": "Values parse as the column type; required fields are not empty.",
      "checks": {
        "bad_value": {
          "message": "{value} is not a valid {type}"
        },
        "required_empty": {
          "message": "{column} is empty",
          "missing": true
        },
        "out_of_bounds": {
          "message": "{column} ({value}) outside [{min}, {max}]"
        },
        "row_length": {
          "message": "row has {found} cells, header has {expected}"
        },
        "decimal_mark": {
          "message": "{value}: in a file separated by {delimiter} the decimal mark is {decimal}"
        },
        "bad_date": {
          "message": "{value} is not a valid date (YYYY-MM-DD)"
        },
        "bad_datetime": {
          "message": "{value} is not a valid date and time (YYYY-MM-DDThh:mm with time zone, e.g. 2026-10-14T09:30+03:00)"
        }
      }
    },
    {
      "code": "E05",
      "level": "error",
      "text": "Primary keys are unique.",
      "checks": {
        "duplicate_key": {
          "message": "duplicate key {key} (first at row {first_row})"
        }
      }
    },
    {
      "code": "E06",
      "level": "error",
      "text": "References resolve (including layers.unit and campaign -> file). With several campaigns, every point names one; source_file points to a file in attachments/.",
      "checks": {
        "unresolved": {
          "message": "{column} {value} not found in {table}"
        },
        "campaign_unresolved": {
          "message": "campaign {value} has no file campaigns/{value}.toml"
        },
        "campaign_required": {
          "message": "point {point_id} names no campaign; the package has {count} campaigns",
          "missing": true
        },
        "source_unresolved": {
          "message": "source file {value} not found in attachments/"
        }
      }
    },
    {
      "code": "E07",
      "level": "error",
      "text": "depth_top < depth_base; depths within [0, final_depth].",
      "checks": {
        "top_not_above_base": {
          "message": "depth_base ({base}) <= depth_top ({top})"
        },
        "beyond_final_depth": {
          "message": "{field} ({value}) > final_depth ({final_depth}) of point {point_id}"
        }
      }
    },
    {
      "code": "E08",
      "level": "error",
      "text": "Layers of a point do not overlap.",
      "checks": {
        "overlap": {
          "message": "layer [{top}, {base}) overlaps layer [{other_top}, {other_base}) at row {other_row}"
        }
      }
    },
    {
      "code": "E09",
      "level": "error",
      "text": "Every test_id has a data file and vice versa; depth strictly increasing.",
      "checks": {
        "data_file_missing": {
          "message": "test {test_id} has no file cpt/data/{test_id}.csv"
        },
        "orphan_data_file": {
          "message": "no row in cpt/tests.csv for test {test_id}"
        },
        "not_increasing": {
          "message": "depth ({depth}) is not greater than the previous depth ({previous})"
        }
      }
    },
    {
      "code": "E10",
      "level": "error",
      "text": "Codes come from the vocabularies; wL >= wP; campaign test keys and methods from the vocabulary or prefixed x_.",
      "checks": {
        "unknown_code": {
          "message": "{value} is not in {vocabulary} (allowed: {allowed})"
        },
        "wL_below_wP": {
          "message": "wL ({wL}) < wP ({wP})"
        },
        "unknown_test": {
          "message": "unknown test key {key}"
        },
        "unknown_method": {
          "message": "method {method} is not valid for {test} (allowed: {allowed})"
        }
      }
    },
    {
      "code": "E11",
      "level": "error",
      "text": "Every test with data has its standard declared in the row's campaign; fractions.source is known, or custom with upper_mm.",
      "checks": {
        "standard_missing": {
          "message": "{test} has data in campaign {campaign} but no standard is declared",
          "missing": true
        },
        "fractions_missing": {
          "message": "campaign {campaign} has grain-size data but no [fractions]",
          "missing": true
        },
        "fractions_source_unknown": {
          "message": "fractions.source {source} is neither a known standard nor custom"
        },
        "custom_without_upper_mm": {
          "message": "fractions.source = custom requires upper_mm",
          "missing": true
        },
        "upper_mm_not_custom": {
          "message": "upper_mm is allowed only with source = custom"
        }
      }
    },
    {
      "code": "E12",
      "level": "error",
      "text": "lab_index has either rho/rho_s or gamma/gamma_s.",
      "checks": {
        "both_groups": {
          "message": "lab_index has both {first} and {second}"
        }
      }
    },
    {
      "code": "W01",
      "level": "warning",
      "text": "Gaps in the layering, or layering does not cover [0, final_depth].",
      "checks": {
        "gap": {
          "message": "gap between {base} and {next_top} in point {point_id}"
        },
        "not_from_surface": {
          "message": "layering of point {point_id} starts at {top}, not 0"
        },
        "not_to_final_depth": {
          "message": "layering of point {point_id} ends at {base}; final_depth is {final_depth}"
        }
      }
    },
    {
      "code": "W02",
      "level": "warning",
      "text": "Unknown column without x_ prefix.",
      "checks": {
        "unknown_column": {
          "message": "unknown column {column} (extensions need the x_ prefix)"
        },
        "unknown_file": {
          "message": "unknown file {file}"
        }
      }
    },
    {
      "code": "W03",
      "level": "warning",
      "text": "Values outside plausible ranges.",
      "ranges": {
        "w": [
          0,
          150
        ],
        "qc": [
          0,
          100
        ],
        "rho": [
          1.2,
          2.6
        ],
        "gamma": [
          11.77,
          25.51
        ]
      },
      "checks": {
        "implausible": {
          "message": "{column} = {value} outside the plausible range [{min}, {max}]"
        }
      }
    },
    {
      "code": "W04",
      "level": "warning",
      "text": "Grain-size fractions sum differs from 100 % by more than 1 %.",
      "checks": {
        "fractions_sum": {
          "message": "grain-size fractions sum to {sum} %"
        }
      }
    },
    {
      "code": "W05",
      "level": "warning",
      "text": "Standard not in the registry.",
      "checks": {
        "unknown_standard": {
          "message": "standard {standard} is not in the registry"
        }
      }
    },
    {
      "code": "W06",
      "level": "warning",
      "text": "Sample whose reference depth falls in no layer.",
      "checks": {
        "sample_outside_layers": {
          "message": "reference depth {depth} of sample {sample_id} falls in no layer of point {point_id}"
        }
      }
    },
    {
      "code": "W07",
      "level": "warning",
      "text": "units.csv exists but a layer has no unit.",
      "checks": {
        "layer_without_unit": {
          "message": "layer has no unit although units.csv exists"
        }
      }
    }
  ]
}
